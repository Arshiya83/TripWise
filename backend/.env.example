# ==========================================
# TripWise Backend Environment Variables Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Persistent Database Connection
# Replace with your Atlas connection string (keep IP access or 0.0.0.0/0 enabled in Atlas Network Access)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tripwise?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_secure_jwt_secret_here

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Allowed Frontend Origins for Production CORS
FRONTEND_URL=https://your-frontend-domain.vercel.app
CORS_ORIGIN=https://your-frontend-domain.vercel.app
